{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Antasphere Documentation",
  "description": "Documentation for the Antasphere tool ecosystem: one account, every tool.",
  "colors": {
    "primary": "#7a6652",
    "light": "#db7d5f",
    "dark": "#5c4d3e"
  },
  "background": {
    "color": {
      "light": "#f7f4ec",
      "dark": "#34302c"
    }
  },
  "fonts": {
    "heading": {
      "family": "Sentient",
      "weight": 300,
      "source": "/fonts/Sentient-Light.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "Synonym",
      "weight": 450,
      "source": "/fonts/Synonym-Variable.woff2",
      "format": "woff2"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://antasphere.com"
  },
  "appearance": {
    "default": "system"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "My account",
          "href": "https://account.antasphere.com",
          "icon": "circle-user"
        },
        {
          "anchor": "Slideless",
          "href": "https://slideless.antasphere.com",
          "icon": "presentation-screen"
        },
        {
          "anchor": "antasphere.com",
          "href": "https://antasphere.com",
          "icon": "globe"
        }
      ]
    },
    "products": [
      {
        "product": "Antasphere",
        "description": "One account for every Antasphere tool: sign in once, connected everywhere.",
        "icon": "circle-user",
        "tabs": [
          {
            "tab": "Your account",
            "icon": "circle-user",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "antasphere/index"
                ]
              },
              {
                "group": "Tools",
                "pages": [
                  "antasphere/tools/slideless"
                ]
              }
            ]
          },
          {
            "tab": "Agents & CLI",
            "icon": "terminal",
            "groups": [
              {
                "group": "Agents & CLI",
                "pages": [
                  "antasphere/agents/cli",
                  "antasphere/agents/mcp-connector"
                ]
              }
            ]
          },
          {
            "tab": "Changelog",
            "icon": "list",
            "groups": [
              {
                "group": "Changelog",
                "pages": [
                  "antasphere/changelog"
                ]
              }
            ]
          }
        ]
      },
      {
        "product": "Slideless",
        "description": "Versioned, shareable live links for what your agents build — push decks from a CLI or MCP agent, share them with a secret URL.",
        "icon": "presentation-screen",
        "tabs": [
          {
            "tab": "Getting started",
            "icon": "rocket",
            "groups": [
              {
                "group": "Getting started",
                "pages": [
                  "slideless/index",
                  "slideless/getting-started/connect-an-agent",
                  "slideless/getting-started/antasphere-account"
                ]
              },
              {
                "group": "Concepts",
                "pages": [
                  "slideless/concepts/workspaces",
                  "slideless/concepts/projects",
                  "slideless/concepts/artifact",
                  "slideless/concepts/versions",
                  "slideless/concepts/links",
                  "slideless/concepts/attachments",
                  "slideless/concepts/references"
                ]
              }
            ]
          },
          {
            "tab": "Agents",
            "icon": "terminal",
            "groups": [
              {
                "group": "Agents",
                "pages": [
                  "slideless/agents/cli",
                  "slideless/agents/mcp-connector",
                  "slideless/agents/deck-self-description"
                ]
              }
            ]
          },
          {
            "tab": "Sharing & review",
            "icon": "share-nodes",
            "groups": [
              {
                "group": "Sharing & review",
                "pages": [
                  "slideless/sharing/annotations",
                  "slideless/sharing/forms",
                  "slideless/sharing/downloads",
                  "slideless/sharing/embedding",
                  "slideless/sharing/link-analytics"
                ]
              }
            ]
          },
          {
            "tab": "Self-hosting",
            "icon": "server",
            "groups": [
              {
                "group": "Self-hosting",
                "pages": [
                  "slideless/self-hosting/install",
                  "slideless/self-hosting/hostinger",
                  "slideless/self-hosting/reverse-proxy",
                  "slideless/self-hosting/deployment-profiles",
                  "slideless/self-hosting/upgrade"
                ]
              },
              {
                "group": "Operations",
                "pages": [
                  "slideless/operations/backup-restore",
                  "slideless/operations/scaling"
                ]
              },
              {
                "group": "Security",
                "pages": [
                  "slideless/security/security",
                  "slideless/security/viewer-security-model"
                ]
              },
              {
                "group": "Reference",
                "pages": [
                  "slideless/reference/env-reference"
                ]
              }
            ]
          },
          {
            "tab": "Changelog",
            "icon": "list",
            "groups": [
              {
                "group": "Changelog",
                "pages": [
                  "slideless/changelog"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open Antasphere",
      "href": "https://account.antasphere.com"
    }
  },
  "footer": {
    "socials": {
      "website": "https://antasphere.com",
      "linkedin": "https://www.linkedin.com/company/antasphere"
    }
  },
  "search": {
    "prompt": "Search the documentation"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor",
      "mcp"
    ]
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "rose-pine-dawn",
        "dark": "rose-pine-moon"
      }
    }
  }
}
